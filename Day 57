class Solution {
    public boolean validMountainArray(int[] arr) {
        int n=arr.length;
        int i=0;
        while(i+1<n&&arr[i]<arr[i+1]){
            i++;
        }
        if(i==0||i==n-1){
            return false;
        }
        while(i+1<n&&arr[i]>arr[i+1]){
            i++;
        }
        return i==n-1;
        
    }
}

2.class Solution {
    public int[] sortedSquares(int[] A) {
        int n = A.length;
        int[] result = new int[n];
        int i = 0, j = n - 1;
        for (int p = n - 1; p >= 0; p--) {
            if (Math.abs(A[i]) > Math.abs(A[j])) {
                result[p] = A[i] * A[i];
                i++;
            } else {
                result[p] = A[j] * A[j];
                j--;
            }
        }
        return result;
    }
}
