1. class Solution {
    public boolean canWinNim(int n) {
        
        if (n % 4 != 0)
            return true;
        else
            return false;
    }
}

2.class Solution {
    public boolean isPowerOfFour(int n) {
        if (n <= 0) {
            return false;
        }
        return Math.log(n) / Math.log(4) % 1 == 0;        
    }
}
